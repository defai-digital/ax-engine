      "expected_exit": 2,
      "actual_exit": 2,
      "passed": true,
      "stderr": "error: decoder.logits: expected F32 [1, 128, 8192]\n"
    },
    {
      "case": "wrong-reference-dtype",
      "expected_exit": 2,
      "actual_exit": 2,
      "passed": true,
      "stderr": "error: decoder.logits: expected F32 [1, 128, 8192]\n"
    },
    {
      "case": "nonfinite-reference",
      "expected_exit": 2,
