      "expected_exit": 2,
      "actual_exit": 2,
      "passed": true,
      "stderr": "error: expected one row of 128 BPE IDs in 0..8192\n"
    },
    {
      "case": "oversized-json",
      "expected_exit": 2,
      "actual_exit": 2,
      "passed": true,
      "stderr": "error: JSON input exceeds 2 MiB\n"
