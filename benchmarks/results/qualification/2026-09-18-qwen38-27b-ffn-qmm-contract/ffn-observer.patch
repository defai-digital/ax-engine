@@ -211,8 +211,280 @@ pub(crate) fn reject_unimplemented_qwen4_exp(cfg: &ModelConfig) {
 /// graphs for every layer of the same attention type.
 ///
 /// Returns updated hidden states.
+type DiagnosticStages = std::collections::BTreeMap<&'static str, MlxArray>;
+thread_local! {
+    pub(crate) static DIAGNOSTIC_MODE: std::cell::Cell<u32> = const { std::cell::Cell::new(0) };
+    static DIAGNOSTIC_STAGES: std::cell::RefCell<Option<DiagnosticStages>> = const { std::cell::RefCell::new(None) };
+    static DIAGNOSTIC_ALTERNATES: std::cell::RefCell<Vec<(&'static str, MlxArray, MlxArray)>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+// Ignored diagnostic only. Captures are armed after the production layer and
+// only around layer-zero eager replay; compiled closure leaves stay unchanged.
+pub(crate) fn diagnostic_record(label: &'static str, value: &MlxArray) {
+    DIAGNOSTIC_STAGES.with(|slot| {
+        if let Some(stages) = slot.borrow_mut().as_mut() {
+            assert!(
+                stages.insert(label, value.clone()).is_none(),
+                "duplicate diagnostic stage: {label}"
+            );
+        }
+    });
+}
+
+pub(crate) fn diagnostic_alternate(label: &'static str, actual: &MlxArray, alternate: &MlxArray) {
+    if diagnostic_capture_active() {
+        DIAGNOSTIC_ALTERNATES.with(|slot| {
+            slot.borrow_mut()
+                .push((label, actual.clone(), alternate.clone()))
+        });
+    }
+}
+
+pub(crate) fn diagnostic_capture_active() -> bool {
+    DIAGNOSTIC_STAGES.with(|slot| slot.borrow().is_some())
+}
+
+pub(crate) fn diagnostic_ffn_route(route: &str) {
+    if diagnostic_capture_active() {
+        eprintln!("ffn_dispatch route={route}");
+    }
+}
+
+// A nested closure may trace on its first application. Suppress observers
+// while it is compiled/applied, and capture only the returned real arrays.
+pub(crate) struct DiagnosticCapturePause(Option<DiagnosticStages>);
+
+pub(crate) fn diagnostic_pause_stages() -> DiagnosticCapturePause {
+    DiagnosticCapturePause(DIAGNOSTIC_STAGES.with(|slot| slot.borrow_mut().take()))
+}
+
+impl Drop for DiagnosticCapturePause {
+    fn drop(&mut self) {
+        DIAGNOSTIC_STAGES.with(|slot| {
+            assert!(slot.borrow().is_none());
+            *slot.borrow_mut() = self.0.take();
+        });
+    }
+}
+
+fn diagnostic_begin_stages(route: &str) {
+    DIAGNOSTIC_ALTERNATES.with(|slot| assert!(slot.borrow().is_empty()));
+    DIAGNOSTIC_STAGES.with(|slot| {
+        assert!(slot.borrow().is_none());
+        *slot.borrow_mut() = Some(DiagnosticStages::new());
+    });
+    eprintln!(
+        "hidden_stage_route route={route} exact={} target={} relaxed={} whole_trace={}",
+        crate::fastpath::qwen_linear_mtp_exact_enabled(),
+        crate::fastpath::qwen_linear_mtp_target_verify_enabled(),
+        crate::fastpath::qwen_linear_mtp_relaxed_session_enabled(),
+        crate::fastpath::qwen_linear_mtp_whole_verify_trace_enabled()
+    );
+}
+
+fn diagnostic_take_stages() -> DiagnosticStages {
+    let stages =
+        DIAGNOSTIC_STAGES.with(|slot| slot.borrow_mut().take().expect("capture must be armed"));
+    let alternates = DIAGNOSTIC_ALTERNATES.with(|slot| std::mem::take(&mut *slot.borrow_mut()));
+    for (label, actual, alternate) in alternates {
+        diagnostic_difference(label, 0, &actual, &alternate);
+    }
+    stages
+}
+
+fn diagnostic_compare_stages(target: &DiagnosticStages, ordinary: &DiagnosticStages) {
+    let required = [
+        "layer_input",
+        "attention_input",
+        "conv_state_input",
+        "recurrent_state_input",
+        "projection_qkv",
+        "projection_z",
+        "projection_a",
+        "projection_b",
+        "post_input_q",
+        "post_input_k",
+        "post_input_v",
+        "recurrent_y",
+        "recurrent_state",
+        "attention_gated",
+        "attention_projection",
+        "attention_residual",
+        "ffn_input",
+        "ffn_gate",
+        "ffn_up",
+        "ffn_activation",
+        "ffn_down",
+        "ffn_output",
+        "layer_output",
+    ];
+    for label in required {
+        let a = target
+            .get(label)
+            .unwrap_or_else(|| panic!("missing target stage {label}"));
+        let b = ordinary
+            .get(label)
+            .unwrap_or_else(|| panic!("missing ordinary stage {label}"));
+        diagnostic_difference(&format!("hidden_{label}"), 0, a, b);
+    }
+}
+pub(crate) fn diagnostic_difference(label: &str, layer: usize, a: &MlxArray, b: &MlxArray) {
+    assert_eq!(a.shape(), b.shape());
+    assert_eq!(a.dtype(), b.dtype());
+    eprintln!(
+        "stage_dtype layer={layer} stage={label} dtype={:?}",
+        a.dtype()
+    );
+    let a = mlx_sys::astype(a, mlx_sys::MlxDtype::Float32, None);
+    let b = mlx_sys::astype(b, mlx_sys::MlxDtype::Float32, None);
+    mlx_sys::eval(&[&a, &b]);
+    let mut maximum = 0.0_f32;
+    let mut count = 0;
+    for (x, y) in a.data_f32().iter().zip(b.data_f32()) {
+        assert!(
+            x.is_finite() && y.is_finite(),
+            "non-finite diagnostic input at {label}"
+        );
+        maximum = maximum.max((x - y).abs());
+        count += usize::from(x.to_bits() != y.to_bits());
+    }
+    eprintln!(
+        "stage_compare layer={layer} stage={label} max_abs={maximum:.9e} unequal={count} shape={:?}",
+        a.shape()
+    );
+}
