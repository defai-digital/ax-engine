+                }
+                if let Some(eager) = families::qwen3_linear::layer_forward_verify_functional(
+                    cfg, w, hidden, layer_idx, conv, recurrent,
+                ) {
+                    diagnostic_difference(
+                        "compiled_vs_functional_hidden",
+                        layer_idx,
+                        &out,
+                        &eager.hidden,
+                    );
+                    if let Some((q, a, t)) = cache.linear_mtp_tape_stash(layer_idx) {
+                        diagnostic_difference(
+                            "compiled_vs_functional_qkv",
+                            layer_idx,
+                            &q,
+                            &eager.state.qkv,
+                        );
+                        diagnostic_difference(
+                            "compiled_vs_functional_a",
+                            layer_idx,
+                            &a,
+                            &eager.state.a,
+                        );
+                        diagnostic_difference(
+                            "compiled_vs_functional_tape",
+                            layer_idx,
+                            &t,
+                            &eager.state.tape,
+                        );
+                    }
+                    if let Some(v) = cache.linear_state(layer_idx).0 {
+                        diagnostic_difference(
+                            "compiled_vs_functional_conv",
+                            layer_idx,
+                            v,
+                            &eager.state.conv_state,
+                        );
+                    }
+                    if let Some(v) = cache.linear_state(layer_idx).1 {
+                        diagnostic_difference(
+                            "compiled_vs_functional_recurrent",
+                            layer_idx,
+                            v,
+                            &eager.state.recurrent_state,
+                        );
+                    }
+                }
+                if layer_idx == 0 {
+                    target_stages = Some(diagnostic_take_stages());
+                }
+            }
+        }
+        let _exact = crate::fastpath::scoped_qwen_linear_mtp_exact(false);
+        let _target = crate::fastpath::scoped_qwen_linear_mtp_target_verify(false);
+        let _session = crate::fastpath::scoped_qwen_linear_mtp_relaxed_session(false);
+        let _qmm = crate::model::shared::verify_qmm::QwenMtpVerifyQmmGuard::arm(false);
+        if layer_idx == 0 {
+            diagnostic_begin_stages("ordinary_same_input");
+        }
+        let other = diagnostic_inner_layer_forward(
+            cfg,
+            w,
+            hidden,
+            &mut base,
+            layer_idx,
+            token_offset,
+            per_layer_input,
+            shared_mask,
+        );
+        if layer_idx == 0 {
+            let ordinary_stages = diagnostic_take_stages();
+            let target_stages =
+                target_stages.expect("linear layer-zero target capture is required");
+            diagnostic_compare_stages(&target_stages, &ordinary_stages);
+        }
+        diagnostic_difference("full_layer_same_input", layer_idx, &out, &other);
+        if let (Some((aq, aa, _)), Some((bq, ba, _))) = (
+            cache.linear_mtp_tape_stash(layer_idx),
+            base.linear_mtp_projection_stash(layer_idx),
+        ) {
+            diagnostic_difference("qkv", layer_idx, &aq, &bq);
+            diagnostic_difference("a", layer_idx, &aa, &ba);
+        }
+        let (ac, ar) = cache.linear_state(layer_idx);
+        let (bc, br) = base.linear_state(layer_idx);
+        if let (Some(a), Some(b)) = (ac, bc) {
+            diagnostic_difference("conv_state", layer_idx, a, b);
+        }
+        if let (Some(a), Some(b)) = (ar, br) {
+            diagnostic_difference("recurrent_state", layer_idx, a, b);
+        }
+    }
+    out
+}
