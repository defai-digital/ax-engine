+    );
+    if let Some(mut base) = snapshot {
+        let mut target_stages = None;
+        if cfg.is_linear_attention_layer(layer_idx) {
+            let (conv, recurrent) = base.linear_state(layer_idx);
+            if let (Some(conv), Some(recurrent)) = (conv, recurrent) {
+                let _trace = crate::fastpath::scoped_qwen_linear_mtp_whole_verify_trace(true);
+                if layer_idx == 0 {
