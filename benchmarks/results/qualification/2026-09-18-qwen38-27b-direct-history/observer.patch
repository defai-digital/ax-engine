+fn first_split_cache(cache: &MlxKVCache, layer_count: usize) -> Result<serde_json::Value, String> {
+    let usage = cache.usage_snapshot();
+    if usage.rotated_ring_layers != 0
+        || usage.quantized_layers != 0
+        || cache.fa_block_pool_enabled()
+    {
+        return Err("diagnostic requires observed contiguous non-ring cache layout".to_string());
+    }
+    let mut arrays = Vec::new();
+    for layer in 0..layer_count {
+        if let Some((k, v)) = cache.logical_layer_kv(layer) {
+            for (kind, array) in [("key", k), ("value", v)] {
+                let (metadata, _) = first_split_array(&array)?;
+                arrays.push(serde_json::json!({"layer": layer, "kind": kind, "array": metadata}));
+            }
+        }
+        let (conv, recurrent) = cache.linear_state(layer);
+        for (kind, value) in [("conv", conv), ("recurrent", recurrent)] {
+            if let Some(array) = value {
+                let (metadata, _) = first_split_array(array)?;
+                arrays.push(serde_json::json!({"layer": layer, "kind": kind, "array": metadata}));
+            }
+        }
+    }
+    if usage.full_attention_layers != 16 || usage.linear_state_layers != 48 || arrays.len() != 128 {
+        return Err("unexpected cache layer or state-array count".to_string());
+    }
+    Ok(
+        serde_json::json!({"seq_len": cache.seq_len(), "rope_offset": cache.rope_offset,
+        "mrope_position_delta": cache.mrope_position_delta(),
+        "capacity_tokens": usage.capacity_tokens, "logical_arrays": arrays}),
+    )
+}
