+fn first_split_request_matches(state: &RequestState) -> bool {
+    if state.prompt_prefix_tokens.len() != 409
+        || state.generated_tokens.len() > FIRST_SPLIT_PREFIX.len()
+        || state.generated_tokens != FIRST_SPLIT_PREFIX[..state.generated_tokens.len()]
