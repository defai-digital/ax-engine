+        return false;
+    }
+    let bytes: Vec<u8> = state
+        .prompt_prefix_tokens
+        .iter()
+        .flat_map(|v| v.to_le_bytes())
+        .collect();
+    first_split_hash(&bytes) == "df38781d2e4a8da2028ddc13e6721755870682c442a60330f0036f14584d71ea"
+}
+
+fn first_split_array(value: &MlxArray) -> Result<(serde_json::Value, Vec<f32>), String> {
+    let floats = astype(value, MlxDtype::Float32, None);
+    eval(&[&floats]);
+    let values = floats.data_f32().to_vec();
+    if !values.iter().all(|value| value.is_finite()) {
+        return Err("non-finite diagnostic array".to_string());
+    }
+    let bytes: Vec<u8> = values
+        .iter()
+        .flat_map(|v| v.to_bits().to_le_bytes())
+        .collect();
+    Ok((
+        serde_json::json!({
+            "shape": value.shape(), "dtype": format!("{:?}", value.dtype()),
+            "elements": values.len(), "finite": true,
+            "f32_bits_le_sha256": first_split_hash(&bytes),
+        }),
+        values,
+    ))
+}
+
+fn first_split_diff(label: &str, left: &[f32], right: &[f32]) -> Result<usize, String> {
+    if left.len() != right.len() {
+        return Err(format!("{label}: comparison length mismatch"));
+    }
+    let unequal = left
+        .iter()
+        .zip(right)
+        .filter(|(a, b)| a.to_bits() != b.to_bits())
+        .count();
+    let max_abs = left
+        .iter()
+        .zip(right)
+        .map(|(a, b)| (a - b).abs())
+        .fold(0.0_f32, f32::max);
+    first_split_log(
+        serde_json::json!({"event": "logit_comparison", "label": label,
+        "elements": left.len(), "unequal": unequal, "max_abs": max_abs}),
+    );
+    Ok(unequal)
+}
+
+fn first_split_row(label: &str, scores: &[f32]) {
+    let mut indices: Vec<usize> = (0..scores.len()).collect();
+    indices.sort_by(|&a, &b| scores[b].total_cmp(&scores[a]).then(a.cmp(&b)));
+    let top: Vec<(usize, f32)> = indices
+        .into_iter()
+        .take(8)
+        .map(|id| (id, scores[id]))
+        .collect();
+    first_split_log(serde_json::json!({"event": "row", "label": label,
+        "finite": scores.iter().all(|v| v.is_finite()), "elements": scores.len(),
+        "top8": top, "direct_token": {"token": 279, "logit": scores[279]},
+        "mtp_token": {"token": 6397, "logit": scores[6397]}}));
+}
