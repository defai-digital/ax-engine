diff --git a/crates/ax-engine-mlx/src/history_observer.rs b/crates/ax-engine-mlx/src/history_observer.rs
new file mode 100644
index 00000000..ea869e67
--- /dev/null
+++ b/crates/ax-engine-mlx/src/history_observer.rs
@@ -0,0 +1,100 @@
+// Observation-only build; no product policy changes.
+use crate::kv_cache::MlxKVCache;
+use mlx_sys::{MlxArray, MlxDtype, astype, eval};
+use std::cell::RefCell;
+thread_local! {
+    static CAPTURES: RefCell<Vec<MlxKVCache>> = const { RefCell::new(Vec::new()) };
+}
+fn first_split_hash(bytes: &[u8]) -> String {
+    use sha2::{Digest, Sha256};
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+fn first_split_array(value: &MlxArray) -> Result<(serde_json::Value, Vec<f32>), String> {
+    let floats = mlx_sys::contiguous(&astype(value, MlxDtype::Float32, None), None);
+    eval(&[&floats]);
+    let values = floats.data_f32().to_vec();
+    if !values.iter().all(|value| value.is_finite()) {
+        return Err("non-finite diagnostic array".to_string());
+    }
+    let bytes: Vec<u8> = values
+        .iter()
+        .flat_map(|v| v.to_bits().to_le_bytes())
+        .collect();
+    Ok((
+        serde_json::json!({
+            "shape": value.shape(), "dtype": format!("{:?}", value.dtype()),
+            "elements": values.len(), "finite": true,
+            "f32_bits_le_sha256": first_split_hash(&bytes),
+        }),
+        values,
+    ))
+}
+
+fn first_split_cache(cache: &MlxKVCache, layer_count: usize) -> Result<serde_json::Value, String> {
+    let usage = cache.usage_snapshot();
+    if usage.rotated_ring_layers != 0
+        || usage.quantized_layers != 0
+        || cache.fa_block_pool_enabled()
+    {
+        return Err("diagnostic requires observed contiguous non-ring cache layout".to_string());
+    }
+    let mut arrays = Vec::new();
+    for layer in 0..layer_count {
+        if let Some((k, v)) = cache.logical_layer_kv(layer) {
+            for (kind, array) in [("key", k), ("value", v)] {
+                let (metadata, _) = first_split_array(&array)?;
+                arrays.push(serde_json::json!({"layer": layer, "kind": kind, "array": metadata}));
+            }
+        }
+        let (conv, recurrent) = cache.linear_state(layer);
+        for (kind, value) in [("conv", conv), ("recurrent", recurrent)] {
+            if let Some(array) = value {
+                let (metadata, _) = first_split_array(array)?;
+                arrays.push(serde_json::json!({"layer": layer, "kind": kind, "array": metadata}));
+            }
+        }
+    }
+    if usage.full_attention_layers != 16 || usage.linear_state_layers != 48 || arrays.len() != 128 {
+        return Err("unexpected cache layer or state-array count".to_string());
+    }
+    Ok(
+        serde_json::json!({"seq_len": cache.seq_len(), "rope_offset": cache.rope_offset,
+        "mrope_position_delta": cache.mrope_position_delta(),
+        "capacity_tokens": usage.capacity_tokens, "logical_arrays": arrays}),
+    )
+}
+
+pub fn begin(cache: &MlxKVCache, vocab: usize, token: u32) {
+    if cache.seq_len() == 409 && vocab == 248320 && token == 760 {
+        CAPTURES.with(|cell| *cell.borrow_mut() = vec![cache.clone()]);
+    }
+}
+pub fn capture(cache: &MlxKVCache) {
+    if [410, 411, 522, 524, 525, 526].contains(&cache.seq_len()) {
+        CAPTURES.with(|cell| {
+            let mut rows = cell.borrow_mut();
+            if !rows.is_empty() {
+                rows.push(cache.clone());
+            }
+        });
+    }
+}
+pub fn flush(cache_len: usize) {
+    if cache_len != 527 {
+        return;
+    }
+    let rows = CAPTURES.with(|cell| std::mem::take(&mut *cell.borrow_mut()));
+    for cache in rows {
+        match first_split_cache(&cache, 64) {
+            Ok(value) => eprintln!(
+                "history_cache_probe {}",
+                serde_json::json!({"event":"cache", "value":value})
+            ),
+            Err(error) => eprintln!(
+                "history_cache_probe {}",
+                serde_json::json!({"event":"invalid", "error":error})
+            ),
+        }
+    }
+}
