{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AX Engine benchmark evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine",
    "engine_version",
    "model",
    "drafter",
    "precision",
    "sampling",
    "workload",
    "hardware",
    "measurement",
    "speculation"
  ],
  "properties": {
    "schema_version": {
      "const": "ax.engine.benchmark.v1"
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "engine_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "drafter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "precision": {
      "type": [
        "string",
        "null"
      ]
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_p",
        "top_k",
        "seed"
      ],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_sha256",
        "requests",
        "concurrency",
        "max_new_tokens"
      ],
      "properties": {
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requests": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "max_new_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accelerator",
        "memory_bytes"
      ],
      "properties": {
        "accelerator": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "output_tokens",
        "wall_seconds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "measured",
            "projected",
            "diagnostic",
            "unclassified"
          ]
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "speculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drafted_tokens",
        "accepted_draft_tokens",
        "verify_calls"
      ],
      "properties": {
        "drafted_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "accepted_draft_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "verify_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
